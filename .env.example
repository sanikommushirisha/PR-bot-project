# Copy to .env and fill in. All of these are validated at startup (src/config/index.ts) --
# the process refuses to start if any required value is missing or malformed.

NODE_ENV=development
LOG_LEVEL=info

# --- Fastify server ---
PORT=3000
HOST=0.0.0.0

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Slack (Socket Mode app) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...
# Channel ID (not name) where /agent-task and the trigger emoji are honored.
SLACK_TRIGGER_CHANNEL_ID=C0123456789
# Emoji name (no colons) that triggers a task when reacted onto a message, e.g. "agent-go" for :agent-go:.
SLACK_TRIGGER_EMOJI=agent-go

# --- GitHub auth: pick ONE of the two methods below ---
# Method 1: Personal Access Token (fastest to start with)
GITHUB_TOKEN=ghp_...
# Method 2: GitHub App (leave GITHUB_TOKEN unset if using this)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

GITHUB_DEFAULT_REPO=your-org/your-repo
GITHUB_DEFAULT_BASE_BRANCH=main

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Worker ---
WORKER_SCRATCH_DIR=./scratch
