{
  "name": "slack-agent-bridge",
  "version": "0.1.0",
  "description": "Slack trigger -> Claude Agent SDK coding session -> draft GitHub PR. No auto-merge.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <21 || >=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev:server": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:server": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test:github": "tsx scripts/test-github.ts",
    "test:claude": "tsx scripts/test-claude.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.251",
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@slack/bolt": "^5.0.0",
    "bullmq": "^6.3.2",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "ioredis": "^6.0.0",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "simple-git": "^3.36.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.24.0"
}
