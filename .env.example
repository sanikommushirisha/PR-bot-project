# Copy to .env and fill in. All of these are validated at startup (src/config/index.ts) --
# the process refuses to start if any required value is missing or malformed.

NODE_ENV=development
LOG_LEVEL=info

# --- Fastify server ---
PORT=3000
HOST=0.0.0.0

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379

# --- Telegram (bot API, long polling) ---
# Token from @BotFather, e.g. "123456789:AAE...".
TELEGRAM_BOT_TOKEN=123456789:AAE...
# Chat ID (not username) where /agent_task and the trigger emoji reaction are honored.
# Add the bot to the group and use a helper like @RawDataBot to find it.
TELEGRAM_TRIGGER_CHAT_ID=-1001234567890
# Literal emoji (not a name) that triggers a task when reacted onto a message.
TELEGRAM_TRIGGER_EMOJI=🚀

# --- GitHub auth: pick ONE of the two methods below ---
# Method 1: Personal Access Token (fastest to start with)
GITHUB_TOKEN=ghp_...
# Method 2: GitHub App (leave GITHUB_TOKEN unset if using this)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=

GITHUB_DEFAULT_REPO=your-org/your-repo
GITHUB_DEFAULT_BASE_BRANCH=main

# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Worker ---
WORKER_SCRATCH_DIR=./scratch
