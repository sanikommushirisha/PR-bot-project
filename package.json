{
  "name": "slack-agent-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:bot": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:bot": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test:github": "tsx scripts/test-github.ts",
    "test:claude": "tsx scripts/test-claude.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "@octokit/rest": "^21.0.2",
    "@slack/bolt": "^5.0.0",
    "@slack/web-api": "^8.1.1",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.1.0",
    "simple-git": "^3.36.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
